# ragengine configuration. `python run.py setup` copies this to .env.
# This ONE file controls everything: run.py, the CLI and the web server all read it.
# Format: RAGAUDIT_<SECTION>__<FIELD>=value   (lines starting with # are ignored)

# =============================================================================
# MODELS: switch here, then run the commands listed under "After switching"
# =============================================================================

# --- 1. Chat model (runs in Ollama). Must support tool calling. -------------
#   qwen3:8b    best answers; ~6 GB RAM/VRAM                (default)
#   qwen3:4b    good on a CPU-only laptop with 16 GB RAM
#   qwen3:14b   stronger, needs ~10 GB VRAM
#   qwen3:1.7b  fast; fine for counts/lookups, weak on open questions
#   llama3.1:8b / mistral-nemo / qwen2.5:7b also support tools
RAGAUDIT_GENERATION__MODEL_NAME=qwen3:8b
RAGAUDIT_GENERATION__BASE_URL=http://localhost:11434

# --- 2. Embedding model (Hugging Face; downloaded by `python run.py models`) -
# Pooling and query/passage formatting are chosen automatically for the family
# (Qwen3-Embedding, BGE, E5, others). Pick ONE pair:
#
#   Qwen3 0.6B (default, 1024-d, multilingual)
RAGAUDIT_EMBEDDING__REPO_ID=Qwen/Qwen3-Embedding-0.6B
RAGAUDIT_EMBEDDING__MODEL_PATH=models/Qwen3-Embedding-0.6B
#   BGE large English (1024-d)
# RAGAUDIT_EMBEDDING__REPO_ID=BAAI/bge-large-en-v1.5
# RAGAUDIT_EMBEDDING__MODEL_PATH=models/bge-large-en-v1.5
#   BGE M3 (multilingual, long inputs)
# RAGAUDIT_EMBEDDING__REPO_ID=BAAI/bge-m3
# RAGAUDIT_EMBEDDING__MODEL_PATH=models/bge-m3
#   E5 large multilingual
# RAGAUDIT_EMBEDDING__REPO_ID=intfloat/multilingual-e5-large
# RAGAUDIT_EMBEDDING__MODEL_PATH=models/multilingual-e5-large
#
# Advanced overrides (leave as auto unless you know the model needs otherwise):
# RAGAUDIT_EMBEDDING__POOLING=auto            # auto | last | cls | mean
# RAGAUDIT_EMBEDDING__QUERY_TEMPLATE=auto     # or e.g. "query: {query}"
# RAGAUDIT_EMBEDDING__PASSAGE_TEMPLATE=auto   # or e.g. "passage: {text}"

# --- 3. Reranker (optional second stage; improves narrative answers) --------
RAGAUDIT_RERANKER__ENABLED=true
#   Qwen3 reranker 0.6B (default)
RAGAUDIT_RERANKER__REPO_ID=Qwen/Qwen3-Reranker-0.6B
RAGAUDIT_RERANKER__MODEL_PATH=models/Qwen3-Reranker-0.6B
#   BGE reranker v2 m3 (cross-encoder; also supported)
# RAGAUDIT_RERANKER__REPO_ID=BAAI/bge-reranker-v2-m3
# RAGAUDIT_RERANKER__MODEL_PATH=models/bge-reranker-v2-m3

# --- Device for embedding + reranker: cpu | cuda | mps (Apple Silicon) -------
RAGAUDIT_EMBEDDING__DEVICE=cpu
RAGAUDIT_RERANKER__DEVICE=cpu

# --- After switching ---------------------------------------------------------
#   chat model changed       -> python run.py ollama          (pulls it)
#   embedding model changed  -> python run.py models
#                               python run.py reset --yes      (old vectors are a different space)
#                               python run.py ingest <folder>
#   reranker changed         -> python run.py models          (no re-ingest needed)
#   then                     -> python run.py doctor
# If you forget the reset, the engine refuses to start with a message saying so,
# rather than mixing vectors from two models.

# =============================================================================
# Everything below is optional tuning; the defaults are sensible.
# =============================================================================

# --- Ingest -----------------------------------------------------------------
# true = reports failing a blocking validation check are quarantined (recommended)
RAGAUDIT_INGEST__FAIL_ON_VALIDATION_ERROR=true
RAGAUDIT_INGEST__CHECKPOINT_EVERY=10

# --- Storage (relative to the folder you run from) --------------------------
RAGAUDIT_DATA_DIR=var
RAGAUDIT_CATALOG_PATH=var/catalog.sqlite3
RAGAUDIT_INDEX_DIR=var/index
RAGAUDIT_FIGURE_DIR=var/figures
# numpy (exact, default) | faiss (pip install faiss-cpu; for > ~50k chunks)
RAGAUDIT_RETRIEVAL__BACKEND=numpy
# Passages the reranker scores per search. Lower (e.g. 12) if searches are slow on CPU.
RAGAUDIT_RETRIEVAL__RERANK_K=24

# --- Agent / timeouts ------------------------------------------------------------
# false = old single-pass router (faster, no tool loop)
RAGAUDIT_AGENT__ENABLED=true
# Raise on a slow CPU if answers end early with agent_deadline
RAGAUDIT_AGENT__DEADLINE_S=90
RAGAUDIT_GENERATION__TIMEOUT_S=120
# How long Ollama keeps the chat model loaded after a question
RAGAUDIT_GENERATION__KEEP_ALIVE=60m

# --- API --------------------------------------------------------------------
# Leave empty for local use. Set a long random string before serving on a network.
RAGAUDIT_API__API_KEY=

# --- Logging -----------------------------------------------------------------
RAGAUDIT_LOG_LEVEL=WARNING
RAGAUDIT_LOG_JSON=false
