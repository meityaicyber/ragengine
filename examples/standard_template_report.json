        "https://pay.sarus.example/login"
      ],
      "regulatory_references": [
        "PCI DSS v4.0 Requirement 8.3.4"
      ],
      "observation_description": "The login endpoint accepted 1,000 failed attempts for one account within five minutes without lockout or CAPTCHA.",
      "preconditions": "A list of valid usernames.",
      "proof_of_concept": [
        {
          "sr_no": 4,
          "type": "text",
          "reference": "Log extract 1",
          "capture_date": "2026-03-05",
          "is_retest": false,
          "redacted": "Yes",
          "description": "1,000 failed attempts, no lockout"
        }
      ],
      "impact": "Accounts with weak passwords can be taken over by automated guessing.",
      "likely_root_cause": "No throttling control was implemented on the authentication service.",
      "recommendation": "Lock the account for 15 minutes after 5 failed attempts and add CAPTCHA after 3 failures from one IP.",
      "reference": "NA",
      "new_or_repeat": "New"
    },
