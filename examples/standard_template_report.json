  "detailed_observations": [
    {
      "finding_id": "OBS-01",
      "title": "SQL injection in transaction search",
      "status": "Open",
      "severity": "Critical",
      "impact_level": "Major",
      "likelihood_level": "Easy",
      "cve_id": [],
      "cvss_score": 9.8,
      "cvss_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
      "severity_rationale": "Unauthenticated attackers can read and modify the full transaction database through a single parameter, so impact is Major and likelihood Easy.",
      "reported_epss_score": null,
      "observation_date": "2026-03-04",
      "cwe": [
        "CWE-89"
      ],
      "affected_asset": [
        "https://pay.sarus.example/api/v1/transactions/search"
      ],
      "regulatory_references": [
        "RBI Master Direction on Digital Payment Security Controls 2021, para 6"
      ],
      "observation_description": "The q parameter of the transaction search endpoint is concatenated into a SQL statement. Injecting a single quote returned a database error, and a UNION-based payload returned rows from the users table.",
      "preconditions": "Network access to the public API; no authentication required.",
      "proof_of_concept": [
        {
          "sr_no": 1,
          "type": "image",
          "reference": "Fig 1",
          "capture_date": "2026-03-04",
          "is_retest": false,
          "redacted": "Yes",
          "description": "UNION payload returning user records"
        }
      ],
      "impact": "Full read and write access to payment and customer records, enabling fraud and data theft.",
      "likely_root_cause": "User input is concatenated into SQL instead of using parameterised queries.",
      "recommendation": "Replace string concatenation in the transaction search query with parameterised statements and validate the q parameter against an allow-list of characters.",
      "reference": "https://owasp.org/Top10/A03_2021-Injection/",
      "new_or_repeat": "New"
    },
    {
      "finding_id": "OBS-02",
      "title": "Outdated jQuery with known XSS",
      "status": "Partially Remediated",
      "severity": "High",
      "impact_level": "Moderate",
      "likelihood_level": "Easy",
      "cve_id": [
        "CVE-2020-11023"
      ],
      "cvss_score": 6.1,
      "cvss_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N",
      "severity_rationale": "",
      "reported_epss_score": 0.27,
      "observation_date": "2026-03-05",
      "cwe": [
        "CWE-79"
      ],
      "affected_asset": [
        "https://pay.sarus.example"
      ],
      "regulatory_references": [
        "None"
      ],
      "observation_description": "The merchant portal loads jQuery 3.4.1, which is affected by CVE-2020-11023. The customer portal was upgraded during the engagement; the merchant portal was not.",
      "preconditions": "A victim must open a crafted link while logged in.",
      "proof_of_concept": [
        {
          "sr_no": 2,
          "type": "image",
          "reference": "Fig 2",
          "capture_date": "2026-03-05",
          "is_retest": false,
          "redacted": "NA",
          "description": "Library version banner"
        },
        {
          "sr_no": 3,
          "type": "image",
          "reference": "Fig 3",
          "capture_date": "2026-03-18",
          "is_retest": true,
          "redacted": "NA",
          "description": "Retest: customer portal upgraded to 3.7.1"
        }
      ],
      "impact": "Script execution in a user's session could lead to session theft.",
      "likely_root_cause": "Third-party libraries are not tracked in a dependency inventory.",
      "recommendation": "Upgrade jQuery to 3.7.1 or later on the merchant portal and add front-end libraries to the dependency scanning pipeline.",
      "reference": "https://nvd.nist.gov/vuln/detail/CVE-2020-11023",
      "new_or_repeat": "Repeat"
    },
    {
      "finding_id": "OBS-03",
      "title": "Missing rate limiting on login",
      "status": "Closed",
      "severity": "Medium",
      "impact_level": "Moderate",
      "likelihood_level": "Moderate",
      "cve_id": [],
      "cvss_score": 5.3,
      "cvss_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N",
      "severity_rationale": "Credential stuffing is possible but requires valid username lists, so likelihood is Moderate.",
